<?xml version="1.0" encoding="utf-8"?>
<!-- The margin arrow inks itself: shaft trims on, head appears as it lands. -->
<animated-vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:drawable="@drawable/ic_sketch_arrow">
    <target android:name="arrow_shaft">
        <aapt:attr name="android:animation">
            <objectAnimator
                android:duration="360"
                android:propertyName="trimPathEnd"
                android:valueType="floatType"
                android:valueFrom="0.0"
                android:valueTo="1.0"
                android:interpolator="@android:interpolator/fast_out_slow_in" />
        </aapt:attr>
    </target>
    <target android:name="arrow_head">
        <aapt:attr name="android:animation">
            <objectAnimator
                android:startOffset="240"
                android:duration="160"
                android:propertyName="strokeAlpha"
                android:valueType="floatType"
                android:valueFrom="0.0"
                android:valueTo="1.0" />
        </aapt:attr>
    </target>
</animated-vector>
