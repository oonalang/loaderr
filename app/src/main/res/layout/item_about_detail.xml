<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="56dp"
    android:gravity="center_vertical"
    android:orientation="horizontal">

    <ImageView
        android:id="@+id/about_detail_icon"
        android:layout_width="20dp"
        android:layout_height="20dp"
        android:contentDescription="Detail"
        android:src="@drawable/ic_about" />

    <TextView
        android:id="@+id/about_detail_label"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="14dp"
        android:layout_weight="1"
        android:text="App information"
        android:textColor="@color/clay_muted"
        android:textSize="15sp" />

    <TextView
        android:id="@+id/about_detail_value"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:ellipsize="end"
        android:gravity="end"
        android:maxLines="1"
        android:text="SHAI LOADER"
        android:textColor="@color/clay_ink"
        android:textSize="15sp"
        android:textStyle="bold" />
</LinearLayout>
