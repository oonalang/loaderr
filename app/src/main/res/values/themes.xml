<resources xmlns:tools="http://schemas.android.com/tools">
    <style name="AppTheme" parent="Theme.Material3.DayNight.NoActionBar">
        <!-- Functional voice: Space Grotesk. Caveat is used only by annotations. -->
        <item name="android:fontFamily">@font/space_grotesk</item>
        <item name="fontFamily">@font/space_grotesk</item>
        <item name="android:navigationBarColor">@color/background_color_dark</item>
        <item name="android:windowBackground">@color/background_color_dark</item>
        <item name="android:textColor">@color/textColor</item>
        <item name="android:statusBarColor">@color/background_color_dark</item>
        <item name="android:colorAccent">@color/max_gold</item>
        <item name="colorPrimary">@color/max_gold</item>
        <item name="colorSecondary">@color/max_orchid</item>
        <item name="android:windowLightStatusBar">false</item>
    </style>

    <!-- Light window surface so the paper splash never flashes the dark theme. -->
    <style name="SplashTheme" parent="AppTheme">
        <item name="android:windowBackground">@color/sketch_paper</item>
        <item name="android:windowLightStatusBar">true</item>
    </style>

    <!-- Errors and confirmations belong to the same light material as the app.
         The old near-black sheet made every dialog look like a different product. -->
    <style name="DarkAlertDialog" parent="ThemeOverlay.Material3.MaterialAlertDialog">
        <item name="colorPrimary">@color/clay_ink</item>
        <item name="colorSurface">@color/clay_raised</item>
        <item name="colorOnSurface">@color/clay_ink</item>
        <item name="android:background">@color/clay_raised</item>
        <item name="android:textColorPrimary">@color/clay_ink</item>
        <item name="android:textColorSecondary">@color/clay_muted</item>
        <item name="android:windowLightStatusBar">true</item>
    </style>
</resources>
