<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/root_container"
    android:layout_width="match_parent" android:layout_height="match_parent">

    <astral.loader.LoaderBackdropView
        android:id="@+id/phase_backdrop"
        android:layout_width="match_parent" android:layout_height="match_parent" />

    <ScrollView
        android:id="@+id/main_scroll"
        android:layout_width="match_parent" android:layout_height="match_parent"
        android:fillViewport="true" android:clipToPadding="false" android:scrollbars="none">
        <LinearLayout android:id="@+id/main_content" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:orientation="vertical"
            android:paddingStart="20dp" android:paddingEnd="20dp"
            android:paddingTop="26dp" android:paddingBottom="36dp">

            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                android:gravity="center_vertical" android:orientation="horizontal">
                <ImageButton android:id="@+id/library_menu_button"
                    android:layout_width="48dp" android:layout_height="48dp"
                    android:background="@android:color/transparent" android:contentDescription="Open library list"
                    android:padding="12dp" android:src="@drawable/ic_menu" />
                <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
                    android:layout_weight="1" android:orientation="vertical" android:gravity="center">
                    <TextView android:id="@+id/brand_title" android:layout_width="wrap_content"
                        android:layout_height="wrap_content" android:text="SHAI LOADER"
                        android:textSize="24sp" android:textStyle="bold" />
                    <TextView android:id="@+id/brand_subtitle" android:layout_width="wrap_content"
                        android:layout_height="wrap_content" android:layout_marginTop="3dp"
                        android:letterSpacing="0.16" android:text="CONCEPT ACCESS / SKETCH MODE"
                        android:textSize="10sp" />
                </LinearLayout>
                <TextView android:id="@+id/phase_marker"
                    android:layout_width="48dp" android:layout_height="48dp"
                    android:gravity="center" android:text="◆" android:textSize="25sp"
                    android:contentDescription="SHAI theme emblem" />
            </LinearLayout>

            <TextView android:id="@+id/chapter_label"
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginTop="28dp" android:letterSpacing="0.06"
                android:text="LIBRARY ACCESS" android:textSize="11sp" />

            <!-- One illustration, not a decorative stack: paper figure becomes a violet sigil. -->
            <LinearLayout android:id="@+id/hero_block"
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginTop="32dp" android:gravity="center_vertical"
                android:orientation="horizontal">
                <ImageView android:id="@+id/hero_art"
                    android:layout_width="104dp" android:layout_height="128dp"
                    android:layout_marginEnd="16dp" android:scaleType="fitCenter"
                    android:contentDescription="Hand-drawn figure" android:src="@drawable/hero_sketch" />
                <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
                    android:layout_weight="1" android:orientation="vertical">
                    <TextView android:id="@+id/hero_headline" android:layout_width="match_parent"
                        android:layout_height="wrap_content" android:text="Your key comes first."
                        android:textSize="26sp" android:fontFamily="sans-serif-medium"
                        android:includeFontPadding="false" android:maxLines="4" />
                    <TextView android:id="@+id/hero_caption" android:layout_width="match_parent"
                        android:layout_height="wrap_content" android:layout_marginTop="12dp"
                        android:text="Redeem a key, then choose a library."
                        android:textSize="14sp" android:lineSpacingExtra="3dp" />
                </LinearLayout>
            </LinearLayout>

            <LinearLayout android:id="@+id/license_section"
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginTop="24dp" android:orientation="vertical">
                <TextView android:id="@+id/license_heading" android:layout_width="match_parent"
                    android:layout_height="wrap_content" android:letterSpacing="0.13"
                    android:text="YOUR LICENSE" android:textSize="11sp" />
                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/input_layout"
                    android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:hint="License key"
                    app:boxBackgroundMode="outline"
                    app:boxCornerRadiusBottomEnd="6dp" app:boxCornerRadiusBottomStart="6dp"
                    app:boxCornerRadiusTopEnd="6dp" app:boxCornerRadiusTopStart="6dp"
                    app:endIconMode="password_toggle">
                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/input_key" android:layout_width="match_parent"
                        android:layout_height="wrap_content" android:inputType="textPassword"
                        android:singleLine="true" android:minHeight="58dp"
                        android:textSize="15sp" />
                </com.google.android.material.textfield.TextInputLayout>
            </LinearLayout>

            <LinearLayout android:id="@+id/success_section"
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginTop="25dp" android:orientation="horizontal"
                android:padding="16dp" android:gravity="center_vertical"
                android:visibility="gone">
                <TextView android:id="@+id/success_emblem"
                    android:layout_width="54dp" android:layout_height="54dp"
                    android:gravity="center" android:text="✦" android:textSize="30sp" />
                <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
                    android:layout_marginStart="12dp" android:layout_weight="1"
                    android:orientation="vertical">
                    <TextView android:id="@+id/success_title" android:layout_width="match_parent"
                        android:layout_height="wrap_content" android:text="License verified"
                        android:textStyle="bold" android:textSize="18sp" />
                    <TextView android:id="@+id/success_detail" android:layout_width="match_parent"
                        android:layout_height="wrap_content" android:layout_marginTop="4dp"
                        android:text="Choose a library to prepare." android:textSize="12sp" />
                    <TextView android:id="@+id/change_key_link"
                        android:layout_width="wrap_content" android:layout_height="48dp"
                        android:layout_marginTop="4dp" android:gravity="center_vertical"
                        android:paddingEnd="16dp" android:text="Use another key"
                        android:textSize="13sp" android:clickable="true" android:focusable="true"
                        android:contentDescription="Return to key redemption" />
                </LinearLayout>
            </LinearLayout>

            <LinearLayout android:id="@+id/library_card"
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginTop="20dp" android:orientation="vertical"
                android:clickable="true" android:focusable="true"
                android:contentDescription="Choose a library" android:minHeight="136dp"
                android:padding="18dp">
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:gravity="center_vertical" android:orientation="horizontal">
                    <ImageView android:id="@+id/app_banner"
                        android:layout_width="72dp" android:layout_height="72dp"
                        android:contentDescription="Selected library logo"
                        android:scaleType="centerCrop" />
                    <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
                        android:layout_marginStart="18dp" android:layout_weight="1"
                        android:orientation="vertical">
                        <TextView android:id="@+id/library_name"
                            android:layout_width="match_parent" android:layout_height="wrap_content"
                            android:text="No library selected" android:textSize="20sp" android:textStyle="bold"
                            android:ellipsize="end" android:maxLines="2" />
                        <TextView android:id="@+id/library_game"
                            android:layout_width="match_parent" android:layout_height="wrap_content"
                            android:layout_marginTop="6dp" android:text="Select after redeeming"
                            android:textSize="12sp" android:ellipsize="end" android:maxLines="2" />
                        <TextView android:id="@+id/library_version"
                            android:layout_width="match_parent" android:layout_height="wrap_content"
                            android:layout_marginTop="5dp" android:textSize="11sp" />
                    </LinearLayout>
                    <TextView android:id="@+id/library_arrow" android:layout_width="24dp"
                        android:layout_height="wrap_content" android:gravity="center" android:text="›"
                        android:textSize="26sp" />
                </LinearLayout>
                <View android:layout_width="match_parent" android:layout_height="1dp"
                    android:layout_marginTop="16dp" android:background="#4D86818C" />
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:layout_marginTop="12dp" android:orientation="horizontal"
                    android:gravity="center_vertical">
                    <TextView android:id="@+id/library_package"
                        android:layout_width="0dp" android:layout_height="wrap_content"
                        android:layout_weight="1" android:ellipsize="end" android:maxLines="1"
                        android:text="Package not selected" android:textSize="10sp" />
                    <TextView android:id="@+id/library_status" android:layout_width="wrap_content"
                        android:layout_height="wrap_content" android:text="NOT SELECTED"
                        android:paddingStart="7dp" android:paddingEnd="7dp"
                        android:textSize="10sp" />
                </LinearLayout>
            </LinearLayout>

            <Button android:id="@+id/login_button" android:layout_width="match_parent"
                android:layout_height="56dp" android:layout_marginTop="18dp"
                android:fontFamily="sans-serif-medium"
                android:text="REDEEM KEY" android:textAllCaps="false" android:textSize="16sp"
                android:letterSpacing="0.09" android:stateListAnimator="@null" />

            <ProgressBar android:id="@+id/progressBar"
                style="?android:attr/progressBarStyleHorizontal"
                android:layout_width="match_parent" android:layout_height="3dp"
                android:layout_marginTop="7dp" android:visibility="gone" android:max="100" />

            <Button android:id="@+id/browse_button" android:layout_width="match_parent"
                android:layout_height="52dp" android:layout_marginTop="12dp"
                android:text="OPEN LIBRARY LIST" android:textAllCaps="false"
                android:letterSpacing="0.10" android:textSize="13sp"
                android:stateListAnimator="@null" />

            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginTop="32dp" android:gravity="center_vertical"
                android:orientation="horizontal">
                <TextView android:id="@+id/footer_text" android:layout_width="0dp"
                    android:layout_height="wrap_content" android:layout_weight="1"
                    android:text="@Shaiaintshyy" android:textSize="11sp" />
                <TextView android:id="@+id/about_button" android:layout_width="wrap_content"
                    android:layout_height="48dp" android:gravity="center_vertical"
                    android:paddingStart="16dp" android:paddingEnd="4dp"
                    android:clickable="true" android:focusable="true"
                    android:text="ABOUT  ↗" android:textSize="12sp" />
            </LinearLayout>

            <!-- Existing operational controls are retained for compatibility with the loader core. -->
            <Spinner android:id="@+id/my_spinner" android:layout_width="1dp" android:layout_height="1dp" android:visibility="gone" />
            <Spinner android:id="@+id/delay_spinner" android:layout_width="1dp" android:layout_height="1dp" android:visibility="gone" />
            <Spinner android:id="@+id/method_spinner" android:layout_width="1dp" android:layout_height="1dp" android:visibility="gone" />
            <RadioGroup android:id="@+id/radioGroup" android:layout_width="1dp" android:layout_height="1dp" android:visibility="gone">
                <RadioButton android:id="@+id/radio_auto" android:layout_width="1dp" android:layout_height="1dp" />
                <RadioButton android:id="@+id/radio_manual" android:layout_width="1dp" android:layout_height="1dp" />
            </RadioGroup>
            <TextView android:id="@+id/root_status" android:layout_width="1dp" android:layout_height="1dp" android:visibility="gone" />
        </LinearLayout>
    </ScrollView>

    <View android:id="@+id/drawer_scrim" android:layout_width="match_parent"
        android:layout_height="match_parent" android:background="#B9000000"
        android:clickable="true" android:focusable="true" android:visibility="gone" />
    <FrameLayout android:id="@+id/library_drawer" android:layout_width="300dp"
        android:layout_height="match_parent" android:translationX="-300dp"
        android:visibility="visible" android:elevation="12dp">
        <LinearLayout android:layout_width="match_parent" android:layout_height="match_parent"
            android:orientation="vertical" android:paddingStart="18dp" android:paddingEnd="18dp"
            android:paddingTop="34dp" android:paddingBottom="20dp">
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="horizontal" android:gravity="center_vertical">
                <TextView android:id="@+id/drawer_title" android:layout_width="0dp"
                    android:layout_height="wrap_content" android:layout_weight="1"
                    android:text="Available libraries" android:textSize="20sp" android:textStyle="bold" />
                <ImageButton android:id="@+id/drawer_close" android:layout_width="44dp"
                    android:layout_height="44dp" android:padding="12dp"
                    android:src="@drawable/ic_close" android:contentDescription="Close library list"
                    android:background="@android:color/transparent" />
            </LinearLayout>
            <EditText android:id="@+id/library_search" android:layout_width="match_parent"
                android:layout_height="50dp" android:layout_marginTop="20dp"
                android:paddingStart="14dp" android:paddingEnd="14dp" android:singleLine="true"
                android:inputType="text" android:hint="Search libraries" android:textSize="14sp" />
            <TextView android:id="@+id/library_count" android:layout_width="match_parent"
                android:layout_height="wrap_content" android:layout_marginTop="20dp"
                android:text="Redeem a key to see libraries" android:textSize="11sp" />
            <ScrollView android:layout_width="match_parent" android:layout_height="0dp"
                android:layout_weight="1" android:layout_marginTop="10dp" android:scrollbars="none">
                <LinearLayout android:id="@+id/library_list" android:layout_width="match_parent"
                    android:layout_height="wrap_content" android:orientation="vertical" />
            </ScrollView>
            <TextView android:id="@+id/drawer_about" android:layout_width="match_parent"
                android:layout_height="52dp" android:gravity="center_vertical"
                android:clickable="true" android:focusable="true"
                android:contentDescription="Visit SHAI store"
                android:text="VISIT MY STORE  ↗" android:textSize="12sp" />
        </LinearLayout>
    </FrameLayout>
</FrameLayout>
