<?xml version="1.0" encoding="utf-8"?>
<!-- The cover of the notebook: one wordmark, one drawn figure, one honest status line.
     No sheet numbers, no invented subtitles, no bordered container. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/splash_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <astral.loader.LoaderBackdropView
        android:id="@+id/splash_page"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <LinearLayout
        android:id="@+id/splash_content"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:paddingStart="32dp"
        android:paddingTop="24dp"
        android:paddingEnd="32dp"
        android:paddingBottom="24dp">

        <TextView
            android:id="@+id/splash_brand"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:includeFontPadding="false"
            android:letterSpacing="-0.02"
            android:paddingStart="4dp"
            android:paddingTop="2dp"
            android:paddingEnd="8dp"
            android:paddingBottom="8dp"
            android:text="SHAI LOADER"
            android:textColor="@color/sketch_ink"
            android:textSize="36sp"
            android:textStyle="bold" />

        <astral.loader.ShaiIllustrationView
            android:id="@+id/splash_art"
            android:layout_width="match_parent"
            android:layout_height="150dp"
            android:layout_marginTop="18dp"
            android:importantForAccessibility="no" />

        <TextView
            android:id="@+id/splash_status"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:gravity="center"
            android:text="Checking your connection"
            android:textColor="@color/sketch_pencil"
            android:textSize="16sp" />
    </LinearLayout>
</FrameLayout>
