<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/root_container"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <astral.loader.LoaderBackdropView
        android:id="@+id/phase_backdrop"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <ScrollView
        android:id="@+id/main_scroll"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipToPadding="false"
        android:fillViewport="true"
        android:scrollbars="none">

        <LinearLayout
            android:id="@+id/main_content"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="20dp"
            android:paddingTop="22dp"
            android:paddingEnd="20dp"
            android:paddingBottom="36dp">

            <!-- Sheet plate: the concept-drawing label before auth, the access plate after. -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/sheet_plate"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:letterSpacing="0.18"
                    android:text="SHAI / 01"
                    android:textSize="11sp" />

                <View
                    android:id="@+id/sheet_rule"
                    android:layout_width="0dp"
                    android:layout_height="1dp"
                    android:layout_marginStart="10dp"
                    android:layout_marginEnd="10dp"
                    android:layout_weight="1"
                    android:background="#3D6F6270" />

                <TextView
                    android:id="@+id/sheet_note"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:gravity="end"
                    android:layout_height="wrap_content"
                    android:letterSpacing="0.02"
                    android:text="Not yet verified"
                    android:textSize="11sp" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ImageButton
                    android:id="@+id/library_menu_button"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:background="@android:color/transparent"
                    android:contentDescription="Open library list"
                    android:padding="12dp"
                    android:src="@drawable/ic_menu" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/brand_title"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:includeFontPadding="false"
                        android:text="SHAI LOADER"
                        android:textSize="25sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/brand_subtitle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:letterSpacing="0.02"
                        android:text="The keykeeper’s notebook"
                        android:textSize="11sp" />
                </LinearLayout>

            </LinearLayout>

            <astral.loader.OrnamentRuleView
                android:id="@+id/hero_rule"
                android:layout_width="match_parent"
                android:layout_height="20dp"
                android:layout_marginTop="8dp" />

            <TextView
                android:id="@+id/chapter_label"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:letterSpacing="0.02"
                android:text="Library access"
                android:textSize="11sp" />

            <!-- One illustration that becomes the crest. Taped onto the sheet
                 before auth; the tape lifts as the court takes over. -->
            <LinearLayout
                android:id="@+id/hero_block"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:orientation="vertical">

                <FrameLayout
                    android:id="@+id/hero_tape_frame"
                    android:layout_width="match_parent"
                    android:layout_height="184dp">

                    <ImageView
                        android:id="@+id/hero_art"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:importantForAccessibility="no"
                        android:scaleType="fitCenter"
                        android:src="@drawable/hero_sketch" />

                    <ImageView
                        android:id="@+id/tape_start"
                        android:layout_width="52dp"
                        android:layout_height="18dp"
                        android:layout_gravity="start|top"
                        android:layout_marginStart="16dp"
                        android:layout_marginTop="12dp"
                        android:importantForAccessibility="no"
                        android:rotation="-38"
                        android:src="@drawable/tape_piece" />

                    <ImageView
                        android:id="@+id/tape_end"
                        android:layout_width="52dp"
                        android:layout_height="18dp"
                        android:layout_gravity="end|top"
                        android:layout_marginEnd="16dp"
                        android:layout_marginTop="12dp"
                        android:importantForAccessibility="no"
                        android:rotation="38"
                        android:src="@drawable/tape_piece" />
                </FrameLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/hero_headline"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:background="@drawable/highlight_swipe"
                        android:includeFontPadding="false"
                        android:paddingBottom="4dp"
                        android:text="Your key comes first."
                        android:textSize="28sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/hero_caption"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:lineSpacingExtra="3dp"
                        android:text="Paste a key from your panel. Nothing opens until it is checked."
                        android:textSize="14sp" />
                </LinearLayout>
            </LinearLayout>

            <LinearLayout
                android:id="@+id/license_section"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="22dp"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/license_heading"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:letterSpacing="0.02"
                    android:text="Your license"
                    android:textSize="11sp" />

                <!-- Margin note: the arrow aims at the real key field below. -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="end|bottom"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/key_note"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginEnd="10dp"
                        android:fontFamily="@font/patrick_hand"
                        android:text="your panel key goes here"
                        android:textColor="@color/sketch_pencil"
                        android:textSize="17sp" />

                    <ImageView
                        android:id="@+id/key_note_arrow"
                        android:layout_width="34dp"
                        android:layout_height="34dp"
                        android:layout_gravity="end"
                        android:layout_marginEnd="52dp"
                        android:importantForAccessibility="no"
                        android:rotation="8"
                        android:scaleType="fitCenter"
                        android:src="@drawable/avd_sketch_arrow" />
                </LinearLayout>

                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/input_layout"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:hint="License key"
                    app:boxBackgroundMode="outline"
                    app:boxCornerRadiusBottomEnd="4dp"
                    app:boxCornerRadiusBottomStart="4dp"
                    app:boxCornerRadiusTopEnd="4dp"
                    app:boxCornerRadiusTopStart="4dp"
                    app:endIconMode="password_toggle">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/input_key"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:imeOptions="actionDone"
                        android:importantForAutofill="no"
                        android:inputType="textPassword"
                        android:minHeight="58dp"
                        android:singleLine="true"
                        android:textSize="15sp" />
                </com.google.android.material.textfield.TextInputLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <CheckBox
                        android:id="@+id/remember_key"
                        android:layout_width="48dp"
                        android:layout_height="48dp"
                        android:background="?attr/selectableItemBackgroundBorderless"
                        android:button="@drawable/checkbox_sheet"
                        android:contentDescription="Remember this key"
                        android:paddingStart="12dp"
                        android:paddingEnd="4dp" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="6dp"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/remember_title"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:labelFor="@id/remember_key"
                            android:text="Remember this key"
                            android:textSize="13sp" />

                        <TextView
                            android:id="@+id/remember_caption"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:text="Redeem automatically the next time SHAI opens."
                            android:textSize="11sp" />
                    </LinearLayout>
                </LinearLayout>
            </LinearLayout>

            <LinearLayout
                android:id="@+id/success_section"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="22dp"
                android:orientation="vertical"
                android:paddingStart="16dp"
                android:paddingTop="16dp"
                android:paddingEnd="16dp"
                android:paddingBottom="8dp"
                android:visibility="gone">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/success_emblem"
                        android:layout_width="54dp"
                        android:layout_height="54dp"
                        android:background="@drawable/seal_ring"
                        android:gravity="center"
                        android:text="✓"
                        android:textSize="26sp" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="14dp"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/success_title"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="Key verified."
                            android:textSize="17sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/success_detail"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:text="Choose a library to prepare."
                            android:textSize="12sp" />
                    </LinearLayout>
                </LinearLayout>

                <View
                    android:id="@+id/success_rule"
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginTop="8dp"
                    android:background="@color/loader_border_soft" />

                <TextView
                    android:id="@+id/key_fingerprint"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:fontFamily="monospace"
                    android:letterSpacing="0.08"
                    android:textSize="11sp"
                    android:visibility="gone" />

                <TextView
                    android:id="@+id/change_key_link"
                    android:layout_width="wrap_content"
                    android:layout_height="48dp"
                    android:layout_marginTop="2dp"
                    android:clickable="true"
                    android:contentDescription="Return to key redemption"
                    android:focusable="true"
                    android:gravity="center_vertical"
                    android:paddingEnd="16dp"
                    android:text="Use another key"
                    android:textSize="13sp" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/library_card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:clickable="true"
                android:contentDescription="Choose a library"
                android:focusable="true"
                android:minHeight="136dp"
                android:orientation="vertical"
                android:padding="18dp"
                android:visibility="gone">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <ImageView
                        android:id="@+id/app_banner"
                        android:layout_width="72dp"
                        android:layout_height="72dp"
                        android:contentDescription="Selected library logo"
                        android:scaleType="centerCrop" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="18dp"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/library_name"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:ellipsize="end"
                            android:maxLines="2"
                            android:text="No library selected"
                            android:textSize="20sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/library_game"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="5dp"
                            android:ellipsize="end"
                            android:maxLines="2"
                            android:text="Select after redeeming"
                            android:textSize="12sp" />

                        <TextView
                            android:id="@+id/library_version"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:textSize="11sp" />
                    </LinearLayout>

                    <TextView
                        android:id="@+id/library_arrow"
                        android:layout_width="24dp"
                        android:layout_height="wrap_content"
                        android:gravity="center"
                        android:text="›"
                        android:textSize="26sp" />
                </LinearLayout>

                <View
                    android:id="@+id/library_divider"
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginTop="16dp"
                    android:background="#4D86818C" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/library_package"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:ellipsize="end"
                        android:maxLines="1"
                        android:text="Package not selected"
                        android:textSize="11sp" />

                    <TextView
                        android:id="@+id/library_status"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:paddingStart="7dp"
                        android:paddingEnd="7dp"
                        android:text="NOT SELECTED"
                        android:textSize="11sp" />
                </LinearLayout>
            </LinearLayout>

            <!-- Real controls, restored: method and launch delay. -->
            <LinearLayout
                android:id="@+id/operation_section"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:orientation="vertical"
                android:visibility="gone">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/operation_heading"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:letterSpacing="0.02"
                        android:text="Injection"
                        android:textSize="11sp" />

                    <TextView
                        android:id="@+id/operation_note"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:letterSpacing="0.02"
                        android:text="Set before prepare"
                        android:textSize="11sp" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:baselineAligned="false"
                    android:orientation="horizontal">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/method_label"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:letterSpacing="0.02"
                            android:text="Method"
                            android:textSize="11sp" />

                        <Spinner
                            android:id="@+id/method_spinner"
                            android:layout_width="match_parent"
                            android:layout_height="50dp"
                            android:layout_marginTop="4dp"
                            android:background="@android:color/transparent"
                            android:contentDescription="Injection method"
                            android:popupBackground="@color/max_deep"
                            android:spinnerMode="dropdown" />
                    </LinearLayout>

                    <Space
                        android:layout_width="12dp"
                        android:layout_height="1dp" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/delay_label"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:letterSpacing="0.02"
                            android:text="Launch delay"
                            android:textSize="11sp" />

                        <Spinner
                            android:id="@+id/delay_spinner"
                            android:layout_width="match_parent"
                            android:layout_height="50dp"
                            android:layout_marginTop="4dp"
                            android:background="@android:color/transparent"
                            android:contentDescription="Delay before injection"
                            android:popupBackground="@color/max_deep"
                            android:spinnerMode="dropdown" />
                    </LinearLayout>
                </LinearLayout>

                <TextView
                    android:id="@+id/control_hint"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:text="Delay waits after the game opens, before the library loads."
                    android:textSize="12sp" />

                <!-- Injection mode: square court boxes replace the old hidden radio stubs.
                     Exactly one of AUTO / MANUAL is ticked at a time. -->
                <TextView
                    android:id="@+id/mode_label"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:letterSpacing="0.02"
                    android:text="Inject mode"
                    android:textSize="11sp" />

                <LinearLayout
                    android:id="@+id/radioGroup"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <CheckBox
                        android:id="@+id/radio_auto"
                        android:layout_width="wrap_content"
                        android:layout_height="48dp"
                        android:background="?attr/selectableItemBackgroundBorderless"
                        android:button="@drawable/checkbox_court"
                        android:contentDescription="Auto inject: open the game, then load the library"
                        android:gravity="center_vertical"
                        android:paddingStart="4dp"
                        android:paddingEnd="6dp"
                        android:text="AUTO"
                        android:textSize="13sp"
                        android:textStyle="bold" />

                    <Space
                        android:layout_width="14dp"
                        android:layout_height="1dp" />

                    <CheckBox
                        android:id="@+id/radio_manual"
                        android:layout_width="wrap_content"
                        android:layout_height="48dp"
                        android:background="?attr/selectableItemBackgroundBorderless"
                        android:button="@drawable/checkbox_court"
                        android:contentDescription="Manual inject: load the library yourself, without opening the game"
                        android:gravity="center_vertical"
                        android:paddingStart="4dp"
                        android:paddingEnd="6dp"
                        android:text="MANUAL"
                        android:textSize="13sp"
                        android:textStyle="bold" />
                </LinearLayout>
            </LinearLayout>

            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/login_button"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:layout_marginTop="16dp"
                android:fontFamily="sans-serif-medium"
                android:letterSpacing="0.09"
                android:stateListAnimator="@null"
                android:text="REDEEM KEY"
                android:textAllCaps="false"
                android:textSize="16sp" />

            <ProgressBar
                android:id="@+id/progressBar"
                style="?android:attr/progressBarStyleHorizontal"
                android:layout_width="match_parent"
                android:layout_height="3dp"
                android:layout_marginTop="7dp"
                android:max="100"
                android:visibility="gone" />

            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/browse_button"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginTop="10dp"
                android:letterSpacing="0.10"
                android:stateListAnimator="@null"
                android:text="OPEN LIBRARY LIST"
                android:textAllCaps="false"
                android:textSize="13sp"
                android:visibility="gone" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="26dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/footer_text"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@Shaiaintshyy"
                    android:textSize="11sp" />

                <TextView
                    android:id="@+id/about_button"
                    android:layout_width="wrap_content"
                    android:layout_height="48dp"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center_vertical"
                    android:paddingStart="16dp"
                    android:paddingEnd="4dp"
                    android:text="ABOUT  ↗"
                    android:textSize="12sp" />
            </LinearLayout>

            <!-- Existing operational controls are retained for compatibility with the loader core. -->
            <Spinner
                android:id="@+id/my_spinner"
                android:layout_width="1dp"
                android:layout_height="1dp"
                android:visibility="gone" />


            <TextView
                android:id="@+id/root_status"
                android:layout_width="1dp"
                android:layout_height="1dp"
                android:visibility="gone" />
        </LinearLayout>
    </ScrollView>

    <View
        android:id="@+id/drawer_scrim"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#B9000000"
        android:clickable="true"
        android:focusable="true"
        android:visibility="gone" />

    <FrameLayout
        android:id="@+id/library_drawer"
        android:layout_width="300dp"
        android:layout_height="match_parent"
        android:elevation="12dp"
        android:translationX="-300dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:paddingStart="18dp"
            android:paddingTop="30dp"
            android:paddingEnd="18dp"
            android:paddingBottom="20dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/drawer_title"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Available libraries"
                    android:textSize="20sp"
                    android:textStyle="bold" />

                <ImageButton
                    android:id="@+id/drawer_close"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:background="@android:color/transparent"
                    android:contentDescription="Close library list"
                    android:padding="12dp"
                    android:src="@drawable/ic_close" />
            </LinearLayout>

            <astral.loader.OrnamentRuleView
                android:id="@+id/drawer_rule"
                android:layout_width="match_parent"
                android:layout_height="18dp"
                android:layout_marginTop="6dp" />

            <EditText
                android:id="@+id/library_search"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:layout_marginTop="12dp"
                android:hint="Search libraries"
                android:imeOptions="actionSearch"
                android:inputType="text"
                android:paddingStart="14dp"
                android:paddingEnd="14dp"
                android:singleLine="true"
                android:textSize="14sp" />

            <TextView
                android:id="@+id/library_count"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="Redeem a key to see libraries"
                android:textSize="11sp" />

            <ScrollView
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_marginTop="8dp"
                android:layout_weight="1"
                android:scrollbars="none">

                <LinearLayout
                    android:id="@+id/library_list"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical" />
            </ScrollView>

            <TextView
                android:id="@+id/drawer_about"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:clickable="true"
                android:contentDescription="Visit SHAI store"
                android:focusable="true"
                android:gravity="center_vertical"
                android:text="VISIT MY STORE  ↗"
                android:textSize="12sp" />
        </LinearLayout>
    </FrameLayout>
</FrameLayout>
