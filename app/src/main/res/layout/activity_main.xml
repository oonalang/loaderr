<?xml version='1.0' encoding='utf-8'?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto" android:id="@+id/root_container" android:layout_width="match_parent" android:layout_height="match_parent">
    <astral.loader.LoaderBackdropView android:id="@+id/phase_backdrop" android:layout_width="match_parent" android:layout_height="match_parent" />
    <ScrollView android:id="@+id/main_scroll" android:layout_width="match_parent" android:layout_height="match_parent" android:clipToPadding="false" android:fillViewport="true" android:scrollbars="none">
        <LinearLayout android:id="@+id/main_content" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:paddingStart="20dp" android:paddingTop="18dp" android:paddingEnd="20dp" android:paddingBottom="16dp" android:clipChildren="false" android:clipToPadding="false">
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical" android:orientation="horizontal">
                <TextView android:id="@+id/brand_title" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:includeFontPadding="false" android:letterSpacing="-0.015" android:text="SHAI LOADER" android:textColor="@color/sketch_ink" android:textSize="27sp" android:textStyle="bold" />
            </LinearLayout>
            <LinearLayout android:id="@+id/hero_block" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:orientation="vertical">
                <FrameLayout android:id="@+id/hero_frame" android:layout_width="match_parent" android:layout_height="156dp">
                    <astral.loader.ShaiIllustrationView android:id="@+id/hero_art" android:layout_width="match_parent" android:layout_height="match_parent" android:importantForAccessibility="no" />
                </FrameLayout>
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical">
                    <astral.loader.RotatingHeadlineView android:id="@+id/hero_headline" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:breakStrategy="balanced" android:ellipsize="end" android:includeFontPadding="false" android:letterSpacing="-0.015" android:maxLines="2" android:minLines="2" android:paddingStart="4dp" android:paddingTop="2dp" android:paddingEnd="8dp" android:paddingBottom="6dp" android:text="Shai Premium is better." android:textColor="@color/sketch_ink" android:textSize="30sp" android:textStyle="bold" />
                    <TextView android:id="@+id/hero_greeting" android:layout_width="match_parent" android:layout_height="wrap_content" android:minLines="2" android:textSize="30sp" android:fontFamily="@font/fredoka_semibold" android:textColor="@color/clay_ink" android:includeFontPadding="false" android:gravity="center_vertical" android:breakStrategy="balanced" android:letterSpacing="-0.01" android:layout_marginTop="4dp" android:visibility="gone" />
                    <TextView android:id="@+id/hero_caption" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:lineSpacingExtra="4dp" android:text="Redeem your key." android:textColor="@color/sketch_pencil" android:textSize="17sp" />
                </LinearLayout>
            </LinearLayout>
            <LinearLayout android:id="@+id/license_section" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="20dp" android:orientation="vertical">
                <TextView android:id="@+id/license_heading" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Your license" android:textColor="@color/sketch_ink" android:textSize="16sp" android:textStyle="bold" />
                <FrameLayout android:id="@+id/key_field" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="10dp" android:paddingStart="16dp" android:paddingTop="6dp" android:paddingEnd="16dp" android:paddingBottom="6dp">
                    <com.google.android.material.textfield.TextInputLayout android:id="@+id/input_layout" android:layout_width="match_parent" android:layout_height="wrap_content" android:hint="Paste your license key" app:boxBackgroundMode="none" app:endIconMode="password_toggle">
                        <com.google.android.material.textfield.TextInputEditText android:id="@+id/input_key" android:layout_width="match_parent" android:layout_height="wrap_content" android:imeOptions="actionDone" android:importantForAutofill="no" android:inputType="textPassword" android:minHeight="56dp" android:paddingStart="2dp" android:paddingEnd="2dp" android:singleLine="true" android:textSize="17sp" />
                    </com.google.android.material.textfield.TextInputLayout>
                </FrameLayout>
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="6dp" android:gravity="start|bottom" android:orientation="vertical">
                    <TextView android:id="@+id/key_note" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="8dp" android:fontFamily="@font/caveat" android:text="saved only if you tick this" android:textColor="@color/sketch_pencil" android:textSize="20sp" />
                    <ImageView android:id="@+id/key_note_arrow" android:layout_width="30dp" android:layout_height="30dp" android:layout_gravity="start" android:layout_marginStart="18dp" android:importantForAccessibility="no" android:rotation="6" android:scaleType="fitCenter" android:src="@drawable/avd_sketch_arrow" />
                </LinearLayout>
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical" android:orientation="horizontal">
                    <CheckBox android:id="@+id/remember_key" android:layout_width="48dp" android:layout_height="48dp" android:background="?attr/selectableItemBackgroundBorderless" android:button="@drawable/checkbox_sheet" android:buttonTint="@null" android:contentDescription="Remember this key" android:paddingStart="12dp" android:paddingEnd="4dp" />
                    <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_marginStart="6dp" android:layout_weight="1" android:orientation="vertical">
                        <TextView android:id="@+id/remember_title" android:layout_width="match_parent" android:layout_height="wrap_content" android:labelFor="@id/remember_key" android:text="Remember this key" android:textColor="@color/sketch_ink" android:textSize="16sp" />
                        <TextView android:id="@+id/remember_caption" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="2dp" android:lineSpacingExtra="3dp" android:text="Redeem automatically the next time SHAI opens." android:textColor="@color/sketch_pencil" android:textSize="16sp" />
                    </LinearLayout>
                </LinearLayout>
            </LinearLayout>
            <LinearLayout android:id="@+id/success_section" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:orientation="vertical" android:paddingStart="22dp" android:paddingTop="16dp" android:paddingEnd="20dp" android:paddingBottom="16dp" android:visibility="gone">
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical" android:orientation="horizontal">
                    <TextView android:id="@+id/success_emblem" android:layout_width="28dp" android:layout_height="28dp" android:background="@drawable/seal_ring" android:gravity="center" android:text="✓" android:textSize="17sp" android:importantForAccessibility="no" />
                    <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_marginStart="12dp" android:layout_weight="1" android:orientation="vertical">
                        <TextView android:id="@+id/success_title" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="License key" android:textColor="@color/sketch_ink" android:textSize="14sp" android:textStyle="bold" />
                        <TextView android:id="@+id/key_fingerprint" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="2dp" android:fontFamily="monospace" android:letterSpacing="0.02" android:textSize="15sp" android:visibility="visible" android:text="••••" />
                    </LinearLayout>
                    <TextView android:id="@+id/change_key_link" android:layout_width="88dp" android:layout_height="wrap_content" android:clickable="true" android:contentDescription="Use another key" android:focusable="true" android:gravity="center" android:paddingStart="6dp" android:paddingEnd="4dp" android:text="Change key" android:textColor="@color/sketch_ink" android:textSize="14sp" android:minHeight="48dp" />
                </LinearLayout>
            </LinearLayout>
            <LinearLayout android:id="@+id/library_card" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:clickable="true" android:contentDescription="Choose your library" android:focusable="true" android:gravity="center_vertical" android:minHeight="106dp" android:orientation="horizontal" android:paddingStart="22dp" android:paddingTop="20dp" android:paddingEnd="20dp" android:paddingBottom="20dp" android:visibility="gone">
                <astral.loader.RoundedArtworkView android:id="@+id/app_banner" android:layout_width="64dp" android:layout_height="64dp" android:background="@color/clay_peri" android:contentDescription="Selected library logo" android:padding="0dp" android:scaleType="centerCrop" />
                <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_marginStart="14dp" android:layout_weight="1" android:orientation="vertical">
                    <TextView android:id="@+id/library_name" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Choose your library" android:textColor="@color/clay_ink" android:textSize="19sp" android:textStyle="bold" />
                    <TextView android:id="@+id/library_game" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="3dp" android:text="Browse available libraries" android:textColor="@color/clay_muted" android:textSize="14sp" />
                    <TextView android:id="@+id/library_version" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="2dp" android:ellipsize="end" android:maxLines="1" android:textColor="@color/clay_muted" android:textSize="13sp" android:visibility="gone" />
                    <TextView android:id="@+id/library_status" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="6dp" android:letterSpacing="0.04" android:text="NOT SELECTED" android:textColor="@color/clay_muted" android:textSize="12sp" android:textStyle="bold" android:visibility="gone" />
                </LinearLayout>
                <ImageView android:id="@+id/library_arrow" android:layout_width="24dp" android:layout_height="24dp" android:layout_marginStart="8dp" android:importantForAccessibility="no" android:src="@drawable/ic_chevron_right" />
            </LinearLayout>
            <LinearLayout android:id="@+id/operation_section" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:orientation="vertical" android:paddingStart="24dp" android:paddingTop="20dp" android:paddingEnd="24dp" android:paddingBottom="20dp" android:visibility="gone">
                <TextView android:id="@+id/operation_heading" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Injection options" android:textColor="@color/clay_ink" android:textSize="20sp" android:textStyle="bold" />
                <TextView android:id="@+id/operation_note" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:lineSpacingExtra="2dp" android:text="Set the method and delay before you prepare." android:textColor="@color/clay_muted" android:textSize="14sp" android:visibility="gone" />
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="14dp" android:baselineAligned="false" android:orientation="horizontal" android:id="@+id/options_fields">
                    <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical" android:id="@+id/method_field">
                        <TextView android:id="@+id/method_label" android:layout_width="match_parent" android:layout_height="wrap_content" android:letterSpacing="0.04" android:text="Method" android:textColor="@color/clay_muted" android:textSize="13sp" android:textStyle="bold" />
                        <Spinner android:id="@+id/method_spinner" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="6dp" android:background="@android:color/transparent" android:contentDescription="Injection method" android:popupBackground="@color/clay_raised" android:spinnerMode="dropdown" android:minHeight="52dp" />
                    </LinearLayout>
                    <Space android:layout_width="14dp" android:layout_height="1dp" android:id="@+id/options_gap" />
                    <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical" android:id="@+id/delay_field">
                        <TextView android:id="@+id/delay_label" android:layout_width="match_parent" android:layout_height="wrap_content" android:letterSpacing="0.04" android:text="Launch delay" android:textColor="@color/clay_muted" android:textSize="13sp" android:textStyle="bold" />
                        <Spinner android:id="@+id/delay_spinner" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="6dp" android:background="@android:color/transparent" android:contentDescription="Delay before injection" android:popupBackground="@color/clay_raised" android:spinnerMode="dropdown" android:minHeight="52dp" />
                    </LinearLayout>
                </LinearLayout>
                <TextView android:id="@+id/control_hint" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="10dp" android:lineSpacingExtra="2dp" android:text="The delay starts after the game opens." android:textColor="@color/clay_muted" android:textSize="14sp" android:visibility="gone" />
                <TextView android:id="@+id/mode_label" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:letterSpacing="0.04" android:text="Mode" android:textColor="@color/clay_muted" android:textSize="13sp" android:textStyle="bold" />
                <RadioGroup android:id="@+id/radioGroup" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="6dp" android:gravity="center_vertical" android:orientation="horizontal" android:padding="4dp">
                    <RadioButton android:id="@+id/radio_auto" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:background="?attr/selectableItemBackgroundBorderless" android:button="@null" android:contentDescription="Auto inject: open the game, then load the library" android:gravity="center" android:paddingStart="4dp" android:paddingEnd="4dp" android:text="AUTO" android:textColor="@color/clay_ink" android:textSize="14sp" android:textStyle="bold" android:buttonTint="@null" android:minHeight="48dp" android:paddingTop="10dp" android:paddingBottom="10dp" />
                    <Space android:layout_width="6dp" android:layout_height="1dp" />
                    <RadioButton android:id="@+id/radio_manual" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:background="?attr/selectableItemBackgroundBorderless" android:button="@null" android:contentDescription="Manual inject: load the library yourself, without opening the game" android:gravity="center" android:paddingStart="4dp" android:paddingEnd="4dp" android:text="MANUAL" android:textColor="@color/clay_ink" android:textSize="14sp" android:textStyle="bold" android:buttonTint="@null" android:minHeight="48dp" android:paddingTop="10dp" android:paddingBottom="10dp" />
                </RadioGroup>
            </LinearLayout>
            <TextView android:id="@+id/success_detail" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="6dp" android:lineSpacingExtra="2dp" android:textColor="@color/sketch_pencil" android:textSize="14sp" android:visibility="gone" android:accessibilityLiveRegion="polite" />
            <androidx.appcompat.widget.AppCompatButton android:id="@+id/login_button" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:letterSpacing="0" android:stateListAnimator="@null" android:text="Redeem key" android:textAllCaps="false" android:textColor="@color/sketch_ink" android:textSize="18sp" android:textStyle="bold" android:minHeight="64dp" android:paddingTop="20dp" android:paddingBottom="20dp" />
            <ProgressBar android:id="@+id/progressBar" style="?android:attr/progressBarStyleHorizontal" android:layout_width="match_parent" android:layout_height="3dp" android:layout_marginTop="6dp" android:max="100" android:visibility="gone" />
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="24dp" android:gravity="center_vertical" android:orientation="horizontal">
                <TextView android:id="@+id/footer_text" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="@Shaiaintshyy" android:textColor="@color/sketch_pencil" android:textSize="16sp" />
                <TextView android:id="@+id/about_button" android:layout_width="wrap_content" android:layout_height="48dp" android:clickable="true" android:contentDescription="About SHAI Loader" android:focusable="true" android:gravity="center_vertical" android:paddingStart="16dp" android:paddingEnd="4dp" android:text="About" android:textColor="@color/sketch_ink" android:textSize="16sp" />
            </LinearLayout>
            <Spinner android:id="@+id/my_spinner" android:layout_width="1dp" android:layout_height="1dp" android:visibility="gone" />
            <TextView android:id="@+id/root_status" android:layout_width="1dp" android:layout_height="1dp" android:visibility="gone" />
        </LinearLayout>
    </ScrollView>
    <View android:id="@+id/drawer_scrim" android:layout_width="match_parent" android:layout_height="match_parent" android:background="#B9000000" android:clickable="true" android:focusable="true" android:visibility="gone" />
    <FrameLayout android:id="@+id/library_drawer" android:layout_width="304dp" android:layout_height="match_parent" android:layout_marginStart="10dp" android:layout_marginTop="10dp" android:layout_marginBottom="10dp" android:elevation="0dp" android:translationX="-314dp" android:clipToOutline="true">
        <LinearLayout android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:paddingStart="18dp" android:paddingTop="24dp" android:paddingEnd="18dp" android:paddingBottom="20dp" android:id="@+id/drawer_content">
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical" android:orientation="horizontal">
                <TextView android:id="@+id/drawer_title" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="Available libraries" android:textColor="@color/clay_ink" android:textSize="22sp" android:textStyle="bold" />
                <ImageButton android:id="@+id/drawer_close" android:layout_width="48dp" android:layout_height="48dp" android:background="@android:color/transparent" android:contentDescription="Close library list" android:padding="12dp" android:src="@drawable/ic_close" />
            </LinearLayout>
            <EditText android:id="@+id/library_search" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="16dp" android:hint="Search libraries" android:imeOptions="actionSearch" android:inputType="text" android:paddingStart="14dp" android:paddingEnd="14dp" android:singleLine="true" android:textSize="16sp" android:minHeight="52dp" android:paddingTop="12dp" android:paddingBottom="12dp" />
            <TextView android:id="@+id/library_count" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="16dp" android:text="Redeem a key to see libraries" android:textColor="@color/clay_muted" android:textSize="13sp" />
            <ScrollView android:layout_width="match_parent" android:layout_height="0dp" android:layout_marginTop="8dp" android:layout_weight="1" android:scrollbars="none">
                <LinearLayout android:id="@+id/library_list" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" />
            </ScrollView>
            <TextView android:id="@+id/drawer_about" android:layout_width="match_parent" android:layout_height="52dp" android:clickable="true" android:contentDescription="Visit SHAI store" android:focusable="true" android:gravity="center_vertical" android:text="Visit my store  ↗" android:textColor="@color/clay_ink" android:textSize="14sp" />
        </LinearLayout>
    </FrameLayout>
</FrameLayout>